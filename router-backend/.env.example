# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# Postgres connection. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://hackcheck:changeme@localhost:5432/hackcheck_router

# ntopng instance running on the box plugged into your switch's mirrored port.
NTOPNG_URL=http://192.168.1.50:3000
NTOPNG_USERNAME=admin
NTOPNG_PASSWORD=changeme

# How often the poller pulls fresh flow data from ntopng, in seconds.
POLL_INTERVAL_SECONDS=60

# Pi-hole instance, typically running on this same box. Leave PIHOLE_PASSWORD
# blank if your Pi-hole has no password set.
PIHOLE_URL=http://127.0.0.1
PIHOLE_PASSWORD=changeme
PIHOLE_POLL_INTERVAL_SECONDS=30

# Suricata's eve.json log, typically on this same box.
SURICATA_EVE_JSON_PATH=/var/log/suricata/eve.json
SURICATA_POLL_INTERVAL_SECONDS=10
