[Unit]
Description=HackCheck Suricata poller
After=network-online.target postgresql.service suricata.service
Wants=network-online.target

[Service]
Type=simple
User=jdstigs
WorkingDirectory=/home/jdstigs/HackCheck/router-backend
ExecStart=/home/jdstigs/HackCheck/router-backend/.venv/bin/python suricata_poller.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
