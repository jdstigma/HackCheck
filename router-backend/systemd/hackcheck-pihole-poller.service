[Unit]
Description=HackCheck Pi-hole poller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=jdstigs
WorkingDirectory=/home/jdstigs/HackCheck/router-backend
ExecStart=/home/jdstigs/HackCheck/router-backend/.venv/bin/python pihole_poller.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
